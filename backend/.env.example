# ============================================
# CHAVEIRO JÁ - VARIÁVEIS DE AMBIENTE
# ============================================

# Copie este arquivo para .env e preencha com seus valores

# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/chaveiroja

# ============================================
# JWT / AUTHENTICATION
# ============================================
JWT_SECRET=seu_jwt_secret_aqui_minimo_32_caracteres_aleatorios_muito_seguro
JWT_REFRESH_SECRET=seu_refresh_secret_aqui_minimo_32_caracteres_muito_aleatorio
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ============================================
# MERCADO PAGO
# ============================================
MERCADO_PAGO_CLIENT_ID=seu_mp_client_id_aqui
MERCADO_PAGO_CLIENT_SECRET=seu_mp_client_secret_aqui
MERCADO_PAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ============================================
# GOOGLE MAPS
# ============================================
GOOGLE_MAPS_API_KEY=sua_chave_de_api_do_google_maps_aqui

# ============================================
# FIREBASE (NOTIFICAÇÕES PUSH)
# ============================================
FIREBASE_PROJECT_ID=seu_firebase_project_id
FIREBASE_PRIVATE_KEY=seu_firebase_private_key_aqui
FIREBASE_CLIENT_EMAIL=seu_firebase_client_email@firebase.iam.gserviceaccount.com

# ============================================
# REDIS (CACHE E REAL-TIME)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# ADMIN PANEL
# ============================================
ADMIN_SECRET=seu_admin_secret_muito_seguro_aqui

# ============================================
# FRONTEND URL (PARA CORS)
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# NOTAS
# ============================================
# 1. JWT_SECRET e JWT_REFRESH_SECRET DEVEM ter pelo menos 32 caracteres
# 2. Gerar valores aleatórios seguros: openssl rand -base64 32
# 3. Nunca compartilhe ou faça commit deste arquivo
# 4. Em produção, use variáveis de ambiente do seu servidor
